{
  "name": "@websideproject/nuxt-protokit",
  "version": "0.0.3",
  "description": "Schema-driven rapid prototyping for Nuxt 4 — turn a TypeScript schema into a persistent, interactive prototype in minutes",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "yjs",
    "offline-first",
    "prototype",
    "prototyping",
    "rapid-prototyping",
    "mvp",
    "form",
    "crud",
    "crdt"
  ],
  "homepage": "https://websideproject.com/docs/nuxt-protokit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/websideproject/nuxt-protokit.git",
    "directory": "packages/nuxt-protokit"
  },
  "bugs": {
    "url": "https://github.com/websideproject/nuxt-protokit/issues"
  },
  "author": {
    "name": "Benjamin Gervan",
    "url": "https://github.com/bgervan"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "release": "bun run lint && bun run test && bun run build && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "@nuxt/kit": "^4.3.0",
    "@vueuse/core": "^14.1.0",
    "date-fns": "^4.1.0",
    "gpu-time": "^0.5.0",
    "ofetch": "^1.5.1"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0",
    "@nuxt/ui": ">=4.5.0",
    "yjs": ">=13.6.0",
    "y-indexeddb": ">=9.0.0",
    "@pinia/nuxt": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@pinia/nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.0",
    "@nuxt/test-utils": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/browser": "^4",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-istanbul": "^4",
    "@vue/test-utils": "^2.4.6",
    "changelogen": "^0.6.2",
    "nuxt": "^4.3.0",
    "playwright": "^1.50.1",
    "typescript": "^5.9.3",
    "vitest": "^4",
    "vue": "^3.5.14",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.24"
  }
}
