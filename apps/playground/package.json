{
  "private": true,
  "name": "nuxt-protokit-playground",
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "dev:prepare": "nuxi prepare",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "build:visual": "bun run --filter @websideproject/nuxt-protokit build && nuxi build",
    "preview:visual": "TZ=UTC PORT=3100 node .output/server/index.mjs",
    "test:visual": "playwright test",
    "visual:baseline": "bash scripts/visual-baseline.sh"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@nuxt/ui": "^4.5.0",
    "@websideproject/nuxt-protokit": "workspace:*",
    "nuxt": "^4.3.0",
    "y-indexeddb": "^9.0.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0"
  }
}
